# ==============================================================================
# HaloMio Core Backend - Template Konfigurasi Lingkungan
# Salin file ini menjadi .env dan sesuaikan nilai variabel di bawah ini.
# JANGAN PERNAH menyimpan API key asli ke dalam sistem version control (Git).
# ==============================================================================

# Port server HTTP Express
PORT=3000

# Kunci Keamanan Utama Komunikasi Antar-Aplikasi Mio
# Gunakan string rahasia dengan entropi tinggi (minimal 32 karakter).
# Anda dapat menghasilkan kunci baru dengan perintah:
#   node -e "console.log('mio_sec_' + require('crypto').randomBytes(24).toString('hex'))"
MIO_API_KEY=mio_sec_your_secret_key_here

# Kebijakan CORS (Domain yang diizinkan mengakses API, dipisahkan tanda koma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Konfigurasi Model AI Cloud (Opsional jika murni menggunakan Ollama lokal)
GEMINI_API_KEY=your_gemini_api_key_here

# Integrasi Google Script / Vault Jadwal
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec
ID_PENERAPAN=your_id_penerapan_here

# Integrasi WhatsApp (Baileys)
GROUP_WA_ID=your_whatsapp_group_id@g.us
