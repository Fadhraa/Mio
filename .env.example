# ==============================================================================
# HaloMio Monorepo - Unified Environment Configuration Template
# Salin file ini menjadi .env di root direktori sebelum menjalankan aplikasi:
#   cp .env.example .env
# ==============================================================================

# Profil Pengguna
USER_NAME=User

# Server Core (Express Backend)
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Kunci Keamanan Komunikasi Antar-Aplikasi Mio (Wajib Sama)
MIO_API_KEY=mio_sec_generate_your_key_here
VITE_MIO_API_KEY=mio_sec_generate_your_key_here

# Frontend Dashboard (Vite)
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# Model AI Eksternal (Opsional jika murni menggunakan Ollama lokal)
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Integrasi Eksternal (WhatsApp & Google Vault)
GROUP_WA_ID=your_group_wa_id@g.us
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec
ID_PENERAPAN=your_id_penerapan_here
